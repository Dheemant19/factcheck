# Copy to .env and adjust. Every path setting is optional (defaults live in factcheck/paths.py).
# PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { Set-Item "env:$($matches[1])" $matches[2] } }
# bash:        set -a; source .env; set +a

# FACTCHECK_DATA_DIR=/home/<you>/factcheck-data
# FACTCHECK_OUTPUT_DIR=/home/<you>/factcheck-outputs
# FACTCHECK_RESULTS_DIR=./results
HF_HOME=~/hf_cache
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_TOKEN=...            # optional: faster Hugging Face downloads; needed for Llama-3.1
# KAGGLE_USERNAME=...     # for ISOT via kagglehub
# KAGGLE_KEY=...
